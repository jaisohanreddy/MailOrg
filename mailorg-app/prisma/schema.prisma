// Prisma schema for MailOrg
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  context       UserContext?
  emailAnalyses EmailAnalysisRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MailOrg application models ---

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  theme         String  @default("system")
  timezone      String?
  digestEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Free-form, user-authored statement of what currently matters to them
// (e.g. "I'm applying for internships, university emails and deadlines
// matter, newsletters don't"). Stored verbatim - no AI structuring happens
// here. One-to-one with User, deliberately separate from
// EmailAnalysisRecord: this is the input to future personalized reasoning,
// not a per-email result.
model UserContext {
  id     String @id @default(cuid())
  userId String @unique

  contextText String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Permanent, per-user storage of successful (never fallback) AI analyses,
// keyed by Gmail message id. analysisVersion lets us intentionally
// invalidate and re-analyze old rows later by bumping ANALYSIS_VERSION in
// src/lib/ai.ts without a migration.
model EmailAnalysisRecord {
  id              String @id @default(cuid())
  userId          String
  messageId       String
  analysisVersion Int

  priority       String
  category       String
  summary        String  @db.Text
  actionRequired Boolean
  action         String? @db.Text
  deadline       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, messageId])
}
