// Prisma schema for MailOrg
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts             Account[]
  sessions             Session[]
  preferences          UserPreferences?
  context              UserContext?
  emailAnalyses        EmailAnalysisRecord[]
  emailFeedback        EmailFeedback[]
  personalizedAnalyses PersonalizedEmailAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- MailOrg application models ---

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  theme         String  @default("system")
  timezone      String?
  digestEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Free-form, user-authored statement of what currently matters to them
// (e.g. "I'm applying for internships, university emails and deadlines
// matter, newsletters don't"). Stored verbatim - no AI structuring happens
// here. One-to-one with User, deliberately separate from
// EmailAnalysisRecord: this is the input to future personalized reasoning,
// not a per-email result.
model UserContext {
  id     String @id @default(cuid())
  userId String @unique

  contextText String @db.Text

  // AI-derived interpretation of contextText (goals/priorities/
  // lowPrioritySignals/currentContext - see src/lib/ai.ts), always written
  // together with contextText so the two never disagree. Null only for
  // rows saved before this interpretation step existed.
  interpretedContext Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Permanent, per-user storage of successful (never fallback) AI analyses,
// keyed by Gmail message id. analysisVersion lets us intentionally
// invalidate and re-analyze old rows later by bumping ANALYSIS_VERSION in
// src/lib/ai.ts without a migration.
model EmailAnalysisRecord {
  id              String @id @default(cuid())
  userId          String
  messageId       String
  analysisVersion Int

  priority       String
  category       String
  summary        String  @db.Text
  actionRequired Boolean
  action         String? @db.Text
  deadline       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, messageId])
}

enum PersonalizedImportance {
  IMPORTANT
  NOT_IMPORTANT
  UNCERTAIN
}

// Answers "what does this email mean for THIS user?" - distinct from
// EmailAnalysisRecord, which answers "what is this email about?" in
// general and is never overwritten or reinterpreted here. Derived from
// UserContext (contextText + interpretedContext) plus the existing general
// analysis, never from Gmail history or EmailFeedback (that's a later
// phase). contextUpdatedAt pins this row to the UserContext.updatedAt it
// was generated against - when the user edits their context, a stored row
// with a different contextUpdatedAt is stale and gets regenerated in
// place (upsert), never duplicated. Stores only the derived judgment, not
// the email body.
model PersonalizedEmailAnalysis {
  id        String @id @default(cuid())
  userId    String
  messageId String

  importance PersonalizedImportance
  reason     String                 @db.Text

  contextUpdatedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, messageId])
}

enum EmailFeedbackDecision {
  IMPORTANT
  NOT_IMPORTANT
}

// The user's own explicit judgment that a specific Gmail message is or
// isn't important to them - a raw behavioral signal, deliberately separate
// from UserContext (the user's stated goals/priorities, not tied to any
// one email) and from EmailAnalysisRecord (AI's own priority/category
// output for an email). Neither of those is read or written here, and
// this table only ever records the judgment itself - never the email body
// - so it stays independent of whether the message still exists in Gmail.
// Learning from this feedback (e.g. inferring "emails like this matter")
// is a later phase; this is storage only.
model EmailFeedback {
  id        String                @id @default(cuid())
  userId    String
  messageId String
  decision  EmailFeedbackDecision

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, messageId])
}
